<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>HullExport</RootNamespace>
  </PropertyGroup>

  <!-- Reaches into the submodule. This project sits outside the sim repo, so it does NOT inherit the
       sim's Directory.Build.props (no implicit System.Numerics using, among other things) - Program.cs
       carries its own usings deliberately. -->
  <ItemGroup>
    <ProjectReference Include="../../external/sailboat-sim/src/Sim.Core/Sim.Core.csproj" />
    <ProjectReference Include="../../external/sailboat-sim/src/Sim.Models/Sim.Models.csproj" />
  </ItemGroup>

</Project>
